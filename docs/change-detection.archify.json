  "meta": {
    "title": "How a Folder Is Judged Changed",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "cheap-first",
        "label": "The cheap answers",
        "focus": [
          "row",
          "ignore",
          "cached",
          "known",
          "answer"
        ],
        "note": "Every tier before the walk is a lookup. Reaching the disk is the last resort, not the first move."
      },
      {
        "id": "one-stat",
        "label": "One stat instead of a tree",
        "focus": [
          "known",
          "persisted",
          "confirm",
          "walk"
        ],
        "note": "A changed verdict rests on a single file, so re-checking that file re-establishes it for every folder above it."
      },
      {
        "id": "staying-honest",
        "label": "Keeping answers honest",
        "focus": [
          "row",
          "watcher",
          "touched",
          "cached"
        ],
        "note": "A snapshot is immutable, so only the live disk can invalidate an answer — and the watch runs only while somebody is browsing."
      }
    ],
