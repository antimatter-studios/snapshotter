  "cards": [
    {
      "dot": "cyan",
      "title": "Why the order is this order",
      "items": [
        "Free checks run before any cache",
        "One stat confirms; sameness needs a walk"
      ]
    },
    {
      "dot": "violet",
      "title": "Why one file settles it",
      "items": [
        "A walk stops at the first difference",
        "If that file differs, so does everything above"
      ]
    },
    {
      "dot": "rose",
      "title": "What makes caching safe",
      "items": [
        "Only the live disk can invalidate an answer",
        "Differences persist; sameness never does"
      ]
    }
